{
  "name": "engine-system-economics",
  "version": "0.5.0",
  "description": "System performance (thermal PR, elevation correction, roof-polygon bin-packing, geodesic area/azimuth) and economics (ROI amortization, savings, CO2) for the Global Rooftop Solar Potential Calculator. Consumes engine-radiation-uncertainty's output.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "engine-radiation-uncertainty": "github:JuyongJuyongJuyong/engine-radiation-uncertainty#v0.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/clipper-lib": "^6.4.0",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JuyongJuyongJuyong/engine-system-economics.git"
  }
}
